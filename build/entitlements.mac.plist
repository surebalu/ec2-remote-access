<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required by Electron/Chromium under the hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- The app opens TCP/TLS connections to instances and AWS APIs, and reads key files the user picks -->
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.security.files.user-selected.read-only</key><true/>
  <!-- Voice dictation: the microphone, for the app and its ec2ra-dictate helper (entitlementsInherit) -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- The Calendar's "Calendars on this Mac", read by the ec2ra-control helper -->
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict>
</plist>
