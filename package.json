{
  "name": "ec2-remote-access",
  "productName": "EC2 Remote Access",
  "version": "1.0.0",
  "description": "Scan AWS accounts for EC2 instances and open SSH / RDP sessions directly (SSM or public IP).",
  "main": "./out/main/index.js",
  "author": "Surendra Balu",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:gateway": "electron-vite build && vite build -c vite.gateway.config.ts",
    "gateway": "node out/gateway/index.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "electron tests/ui-smoke.cjs",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:arm64": "electron-vite build && electron-builder --config electron-builder.config.cjs --mac --arm64 --publish never",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "3.1135.0",
    "@aws-sdk/client-ec2": "^3.1135.0",
    "@aws-sdk/client-ssm": "^3.1135.0",
    "@aws-sdk/client-sso": "^3.1135.0",
    "@aws-sdk/client-sso-oidc": "^3.1135.0",
    "@aws-sdk/client-sts": "^3.1135.0",
    "@aws-sdk/credential-providers": "^3.1135.0",
    "@aws-sdk/shared-ini-file-loader": "^3.374.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@devolutions/iron-remote-desktop": "^0.11.0",
    "@devolutions/iron-remote-desktop-rdp": "^0.7.0",
    "@lezer/highlight": "^1.2.5",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "marked": "^15.0.12",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "homepage": "https://github.com/surebalu/ec2-remote-access"
}
